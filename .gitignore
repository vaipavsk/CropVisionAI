# =====================================
# CropVisionAI - .gitignore
# =====================================

# Python virtual environments
venv/
venv312/
.venv/
env/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Python build
build/
dist/
*.egg-info/

# Environment variables
.env
*.env
!.env.example

# Firebase / service account credentials
*-firebase-adminsdk-*.json
**/*firebase-adminsdk*.json
service-account*.json
firebase-service-account*.json

# Uploads & generated files
uploads/
reports/
ai-service/app/uploads/
ai-service/app/reports/

# Datasets
datasets/

# Node / React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
.cache/
*.tmp
*.bak

# Model checkpoints
# Uncomment if trained models should NOT be committed:
# trained_models/
# *.pt
# *.pth

# Jupyter
.ipynb_checkpoints/
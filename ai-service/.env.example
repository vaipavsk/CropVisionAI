# ==============================================================================
# CropVisionAI AI Service — Environment Variables Template
# ==============================================================================
# Copy this file to `ai-service/.env` and update the values with your local configuration.
# DO NOT commit real passwords, API keys, or private credentials to version control.

PROJECT_NAME=CropVisionAI
VERSION=1.0.0
DEBUG=False

# Database Configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cropvisionai
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password

# Model and Storage Paths
UPLOAD_FOLDER=app/uploads
REPORT_FOLDER=app/reports
YOLO_MODEL_PATH=trained_models/yolov8n.pt
EFFICIENTNET_MODEL_NAME=efficientnet_b0
EFFICIENTNET_WEIGHTS_PATH=trained_models/efficientnet_b0_37class_candidate.pth
EFFICIENTNET_CLASS_MAPPING_PATH=trained_models/class_mapping.json

# Thresholds
YOLO_CONFIDENCE_THRESHOLD=0.25
LOW_DAMAGE_THRESHOLD=15.0
MODERATE_DAMAGE_THRESHOLD=70.0
HIGH_DAMAGE_THRESHOLD=70.0
SEVERE_DAMAGE_THRESHOLD=90.0

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# CropVisionAI Backend — Environment Variables Template
# ==============================================================================
# Copy this file to `backend/.env` and update the values with your local configuration.
# DO NOT commit real passwords, API keys, or private credentials to version control.

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cropvisionai
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# Firebase Admin SDK Credentials Path
# Relative to backend/ directory or an absolute path on your filesystem
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-adminsdk-credentials.json

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
